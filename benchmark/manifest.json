{
  "schema": 1,
  "name": "Pocket Cinema Camera (2013) — banco de fidelidad",
  "dataset": {
    "description": "CinemaDNG originales de la Pocket OG; una carpeta por toma, un DNG por fotograma.",
    "default_root": "~/Desktop/BMD",
    "references_root": "../EXR",
    "notes": [
      "El dataset, los EXR y los BRAW no se versionan."
    ]
  },
  "camera": {
    "route": "og",
    "calibration_iso": 400,
    "signal_ceiling_iso400": 2.14344883,
    "signal_ceiling_source": "decode(4095) × baseline_exposure_gain de la curva calibrada (traza del pipeline); a ISO N el techo es × N/400."
  },
  "encode": {
    "compression": "quality",
    "q": 4,
    "ratio": null,
    "rate_search": true,
    "noise_synthesis": true,
    "workers": 2,
    "notes": [
      "noise_synthesis true es el valor por defecto de la app y del worker.",
      "rate_search solo se aplica en modo ratio (CDNG_RATE=search): sin él el control de tasa depende del orden de los hilos y no es reproducible por fotograma."
    ]
  },
  "decode": {
    "gamut": "DCI-P3 D65",
    "gamma": "Linear",
    "color_science_gen": 5,
    "highlight_recovery": 0,
    "white_balance": "as_shot",
    "iso": "as_shot",
    "exposure": 0,
    "scale": "full",
    "framework": "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Frameworks/BlackmagicRawAPI.framework/BlackmagicRawAPI",
    "camera_support": "/Library/Application Support/Blackmagic Design/Blackmagic RAW/Camera Support",
    "notes": [
      "color_science_gen 5 es la única opción que ofrece el SDK para estos BRAW; «Gen 4» se refiere al revelado del CinemaDNG en Resolve.",
      "Ajustes explícitos comprobados idénticos bit a bit a los valores por defecto de brawdec (P3 D65, Linear, csgn 5, hlry 0)."
    ]
  },
  "analysis": {
    "normalize_to_iso": 200,
    "psnr_peak": 1.0,
    "luminance": "P3-D65",
    "luminance_bins": [
      0.0,
      0.0025,
      0.01,
      0.04,
      0.16,
      0.64,
      1000000000.0
    ],
    "error_percentiles": [
      50,
      90,
      95,
      99,
      99.9
    ],
    "chroma_min_luminance": 0.005,
    "edge_mask": {
      "percentile": 90,
      "dilate": 1,
      "min_luminance": 0.002
    },
    "neutral_mask": {
      "max_duv": 0.01,
      "min_luminance": 0.01
    },
    "ceiling_margin": 0.9999,
    "alignment": {
      "search": 8,
      "min_detail_correlation": 0.74,
      "basis": "Correlación del detalle (paso alto de log2 Y) entre el BRAW revelado y el EXR del DNG, medida en la serie A con los BRAW v2: 0.819–0.820 en el fotograma correcto, 0.637–0.657 en fotogramas vecinos, 0.42 con otra toma de la misma escena. 0.74 separa ambos grupos."
    }
  },
  "visualization": {
    "display_exposure": 2.0,
    "abs_error_max": 0.02,
    "signed_error_max": 0.01,
    "chroma_error_max": 0.02,
    "histogram_max": 0.05,
    "histogram_bins": 100,
    "roi_zoom": 6
  },
  "scenes": {
    "chart_wall": {
      "rois": "rois/chart_wall.json"
    }
  },
